// «Орбита» — схема данных прототипа. Описание и правила доступа: specs/03_DATA_AND_SECURITY.md
// SQLite не поддерживает enum в Prisma, поэтому допустимые значения строковых полей
// фиксируются в комментариях и проверяются на уровне API (src/lib/domain.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String  @id @default(cuid())
  email             String  @unique
  passwordHash      String
  fullName          String
  role              String  // STUDENT | ADMIN | TEACHER (V2)
  faculty           String?
  program           String?
  course            Int?
  groupName         String?
  studyForm         String? // Бюджет | Договор
  studentCardNumber String?
  curatorName       String?
  scholarshipStatus String?
  position          String? // должность сотрудника деканата / преподавателя
  // V2
  department          String? // кафедра (для преподавателей)
  campusHoursWeek     Float   @default(22.5)
  campusHoursSemester Int     @default(318)
  // V3
  avatarUrl       String?   // data:image/(png|jpeg|webp);base64,… (≤ 500 КБ) или https-URL
  avatarUpdatedAt DateTime?
  wifiLogin       String    @default("stud_orbita")
  wifiPassword    String    @default("Orbita#2026WiFi") // секрет, видимый владельцу; см. specs/03 §V3.3
  wifiUpdatedAt   DateTime  @default(now())
  peCurrentPoints Int       @default(14)
  peTargetPoints  Int       @default(20)

  createdAt DateTime @default(now())

  grades        SubjectGrade[]
  assignments   Assignment[]
  requests      DocumentRequest[]
  notifications Notification[]
  bookings      RoomBooking[]
  sentMessages     DirectMessage[] @relation("sentMessages")
  receivedMessages DirectMessage[] @relation("receivedMessages")
  eventRegistrations EventRegistration[]
  sportEnrollment    SportEnrollment?

  @@index([groupName])
  @@index([role, groupName])
}

model ScheduleItem {
  id            String  @id @default(cuid())
  groupName     String
  dayOfWeek     Int     // 1 (Пн) … 6 (Сб)
  startTime     String  // HH:MM
  endTime       String  // HH:MM
  subject       String
  type          String  // Лекция | Практика | Лабораторная
  building      String
  room          String
  oldRoom       String?
  teacher       String
  isRescheduled Boolean @default(false)

  @@index([groupName, dayOfWeek])
}

model SubjectGrade {
  id              String @id @default(cuid())
  userId          String
  subject         String
  teacher         String
  controlType     String // Экзамен | Зачёт
  labsScore       Int
  labsMax         Int
  midtermScore    Int
  midtermMax      Int
  attendanceScore Int
  attendanceMax   Int
  examMax         Int
  currentTotal    Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject])
  @@index([userId])
}

model Assignment {
  id             String    @id @default(cuid())
  userId         String
  subject        String
  title          String
  description    String
  deadline       String    // ISO-8601
  brsWeight      Int
  status         String    // TODO | SUBMITTED | GRADED | OVERDUE
  submissionUrl  String?
  studentComment String?
  submittedAt    DateTime?
  score          Int?

  // V2: онлайн-ДЗ и решение задач на сайте
  authorId        String?  // преподаватель, выдавший задание
  authorName      String   @default("Доц. Волков И.С.")
  groupName       String   @default("М3203")
  taskPrompt      String   @default("") // условие в Markdown
  starterTemplate String?  // шаблон кода/ответа для редактора
  solutionText    String?  // решение, написанное студентом на сайте
  gradeAwarded    Int?     // балл преподавателя (0…brsWeight)
  teacherFeedback String?
  materialId      String?  // привязанная методичка

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  material StudyMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([authorId])
  @@index([groupName])
}

model StudyMaterial {
  id              String   @id @default(cuid())
  faculty         String
  subject         String
  title           String
  category        String   // Конспект | Шпаргалка к РК | Билеты | Шаблон лабы
  readTimeMinutes Int
  contentMarkdown String
  updatedAt       DateTime @default(now())
  quizJson        String?  // V3: банк проверочных вопросов [{ question, options[4], correctIndex, explanation }]

  assignments Assignment[]

  @@index([faculty])
}

model DocumentRequest {
  // Числовой id сделан намеренно: его легко подобрать, и это наглядно показывает,
  // что защита держится на проверке владельца, а не на «непредсказуемости» идентификатора.
  id             Int      @id @default(autoincrement())
  userId         String
  type           String   // STUDY_CERTIFICATE | MILITARY_CERTIFICATE | FINANCIAL_AID | RETAKE | PGAS
  status         String   // NEW | IN_REVIEW | APPROVED | REJECTED
  comment        String?
  adminComment   String?
  registryNumber String   @unique
  reviewedBy     String?  // ФИО сотрудника, принявшего решение
  payloadJson    String?  // V2: структурированные поля онлайн-формы (JSON)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([userId, type, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  category  String   // DEADLINE | SCHEDULE | REQUEST | DEAN | GRADE (V2)
  title     String
  message   String
  isRead    Boolean  @default(false)
  isCritical Boolean @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ───────────────────────── V2

model RoomBooking {
  id                String   @id @default(cuid())
  userId            String
  roomName          String
  building          String
  date              String   // YYYY-MM-DD (московская дата)
  timeSlot          String   // "15:20 – 16:50"
  purpose           String
  participantsCount Int
  status            String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  // "<roomName>|<date>|<timeSlot>" у активной брони, NULL после отмены.
  // Уникальный индекс делает двойное бронирование невозможным даже при гонке запросов.
  activeSlotKey     String?  @unique
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date, roomName])
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, isRead])
}

// ───────────────────────── V3

model CampusEvent {
  id              String @id @default(cuid())
  title           String
  category        String // Хакатон | Митап | Карьера | Наука | Клубы
  description     String
  date            String // YYYY-MM-DD
  timeRange       String // "18:00 – 21:00"
  location        String
  organizer       String
  capacity        Int
  registeredCount Int    @default(0)
  tags            String // через запятую

  registrations EventRegistration[]

  @@index([date])
}

model EventRegistration {
  id         String   @id @default(cuid())
  eventId    String
  userId     String
  ticketCode String   @unique // EVT-2026-XXXX
  createdAt  DateTime @default(now())

  event CampusEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model SportSection {
  id             String @id @default(cuid())
  sportType      String // Плавание | Скалолазание | Футбол | Баскетбол | Настольный теннис | Тренажёрный зал | Киберспорт
  title          String
  coachName      String
  campusLocation String
  scheduleText   String // "Вт, Чт • 17:00 – 18:30"
  capacity       Int
  enrolledCount  Int    @default(0)

  enrollments SportEnrollment[]
}

model SportEnrollment {
  id        String   @id @default(cuid())
  userId    String   @unique // одна активная секция в семестре
  sectionId String
  updatedAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  section SportSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}
