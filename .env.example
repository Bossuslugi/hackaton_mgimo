# 1 — фронтенд работает на встроенных моках без бэкенда (src/lib/mock)
NEXT_PUBLIC_API_MOCK=0

# Путь к файлу SQLite (относительно prisma/). В Docker задаётся в docker-compose.yml.
DATABASE_URL="file:./dev.db"

# Секрет подписи сессионных JWT (>= 32 символов). В production обязателен.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ИИ-ассистент (необязательно). Без ключа Copilot отвечает детерминированно по данным студента.
# Любой OpenAI-совместимый провайдер: укажите базовый URL и модель.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
